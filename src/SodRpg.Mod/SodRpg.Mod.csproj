<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ゲーム本体へ読み込ませるMOD。ゲームのアセンブリを参照するため、CI（SodRpg.sln）には含めない。
    ゲームの場所は環境変数 SOD_GAME_DIR か、ビルド時の -p:GameDir=... で指定する。
    ビルドすると $(GameDir)/Mods/DreamforgeRPG へ about/ と DLL を配置する（そのままWorkshopへ登録できる形）。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>DreamforgeRPG</AssemblyName>
    <RootNamespace>SodRpg.Mod</RootNamespace>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <GameDir Condition="'$(GameDir)' == '' and '$(SOD_GAME_DIR)' != ''">$(SOD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Shape of Dreams</GameDir>
    <GameManagedDir>$(GameDir)\Shape of Dreams_Data\Managed</GameManagedDir>
    <ModDeployDir>$(GameDir)\Mods\DreamforgeRPG</ModDeployDir>
    <!-- 版の切り替え。-p:DreamforgeEdition=special で特別版（夢の種をフラグなしで有効化し、本体の抽選プールへ原型と同じ重みで追加）。既定は通常版。 -->
    <DreamforgeEdition Condition="'$(DreamforgeEdition)' == ''">normal</DreamforgeEdition>
    <DefineConstants Condition="'$(DreamforgeEdition)' == 'special'">$(DefineConstants);DREAMFORGE_SPECIAL</DefineConstants>
  </PropertyGroup>

  <!-- 純C#コアは別DLLにせず同じアセンブリへ取り込む（ゲームは読み込み時にアセンブリ名を書き換えるため、MOD間参照を避ける）。 -->
  <ItemGroup>
    <Compile Include="..\SodRpg.Core\Game\**\*.cs" Link="Core\Game\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\SodRpg.Core\Internal\Json.cs" Link="Core\Internal\Json.cs" />
    <Compile Include="..\SodRpg.Core\IFileSystem.cs" Link="Core\IFileSystem.cs" />
    <Compile Include="..\SodRpg.Core\Exceptions.cs" Link="Core\Exceptions.cs" />
  </ItemGroup>

  <ItemGroup>
    <GameRef Include="mscorlib;netstandard;System;System.Core;0Harmony;Assembly-CSharp;Dew.Core;Dew.Contents;Dew.UI;DOTween;DTT.AreaOfEffectRegions.Runtime;Mirror;Newtonsoft.Json;UniTask;inc8877.GraphicsConfigurator;Unity.RenderPipelines.Universal.Runtime;Unity.RenderPipelines.Core.Runtime;Unity.InputSystem;Unity.TextMeshPro;UnityUIExtensions;UnityEngine;UnityEngine.CoreModule;UnityEngine.AudioModule;UnityEngine.AIModule;UnityEngine.IMGUIModule;UnityEngine.TextRenderingModule;UnityEngine.InputLegacyModule;UnityEngine.UI;UnityEngine.UIModule;UnityEngine.ImageConversionModule;UnityEngine.ParticleSystemModule;UnityEngine.Physics2DModule;UnityEngine.PhysicsModule" />
    <Reference Include="@(GameRef)">
      <HintPath>$(GameManagedDir)\%(Identity).dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="about\**\*" />
    <None Include="icons\**\*" />
    <None Include="lang\**\*" />
  </ItemGroup>

  <!--
    配布用ビルドの名前の難読化（docs/specs/release-obfuscation.md）。
    -p:Obfuscate=true のときだけ Build の後に DreamforgeRPG.dll を Obfuscar で難読化して置き換える。
    既定（プロパティなし）のビルド・テストは一切変わらない。Obfuscar・検査スクリプトが無い場合や
    どちらかが失敗した場合はビルドを失敗させる（難読化していない DLL を配布経路に出さないため）。
  -->
  <Target Name="ObfuscateReleaseDll" AfterTargets="Build" BeforeTargets="DeployToGame" Condition="'$(Obfuscate)' == 'true'">
    <PropertyGroup>
      <!-- 道具を探す（PATH → ~/.dotnet/tools）。無ければ下の Exec が失敗しビルドが止まる。 -->
      <ObfuscarCommand Condition="'$(ObfuscarCommand)' == '' and Exists('$(HOME)/.dotnet/tools/obfuscar.console')">$(HOME)/.dotnet/tools/obfuscar.console</ObfuscarCommand>
      <ObfuscarCommand Condition="'$(ObfuscarCommand)' == ''">obfuscar.console</ObfuscarCommand>
      <ObfuscationRoot>$(MSBuildThisFileDirectory)..\..\tools\obfuscation\</ObfuscationRoot>
      <ObfuscateWorkDir>$(IntermediateOutputPath)obfuscate\</ObfuscateWorkDir>
    </PropertyGroup>
    <Message Importance="high" Text="Obfuscating $(TargetFileName) (Obfuscar, config: $(ObfuscationRoot)obfuscar.xml)" />
    <MakeDir Directories="$(ObfuscateWorkDir)in" />
    <MakeDir Directories="$(ObfuscateWorkDir)out" />
    <ItemGroup>
      <!-- Obfuscar は参照アセンブリを作業ディレクトリから解決するため、ゲームの参照 DLL を一緒に置く。 -->
      <ObfuscateReference Include="@(GameRef->'$(GameManagedDir)\%(Identity).dll')" />
    </ItemGroup>
    <!-- obj のコンパイラ出力を使い、増分ビルドでも難読化を二重に掛けない。 -->
    <Copy SourceFiles="$(IntermediateOutputPath)$(TargetFileName)" DestinationFiles="$(ObfuscateWorkDir)in\DreamforgeRPG.dll" />
    <Copy SourceFiles="@(ObfuscateReference)" DestinationFolder="$(ObfuscateWorkDir)in\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ObfuscationRoot)obfuscar.xml" DestinationFolder="$(ObfuscateWorkDir)" />
    <Copy SourceFiles="$(ObfuscateWorkDir)in\DreamforgeRPG.dll" DestinationFiles="$(ObfuscateWorkDir)DreamforgeRPG.plain.dll" OverwriteReadOnlyFiles="true" />
    <Exec Command="&quot;$(ObfuscarCommand)&quot; obfuscar.xml" WorkingDirectory="$(ObfuscateWorkDir)" />
    <Error Condition="!Exists('$(ObfuscateWorkDir)out\DreamforgeRPG.dll')"
           Text="Obfuscar did not produce an obfuscated DreamforgeRPG.dll; refusing to ship a plain DLL." />
    <!-- 検査に通った DLL だけを bin と配布先へ出す。 -->
    <Exec Command="python3 &quot;$(ObfuscationRoot)check.py&quot; &quot;$(ObfuscateWorkDir)DreamforgeRPG.plain.dll&quot; &quot;$(ObfuscateWorkDir)out/DreamforgeRPG.dll&quot; &quot;$(ObfuscateWorkDir)obfuscar.xml&quot;" />
    <Copy SourceFiles="$(ObfuscateWorkDir)out/DreamforgeRPG.dll" DestinationFiles="$(TargetPath)" OverwriteReadOnlyFiles="true" />
    <Message Importance="high" Text="Obfuscated DLL replaced $(TargetPath). Mapping: $(ObfuscateWorkDir)out\Mapping.txt (配布物には含めない)" />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameDir)\Mods')">
    <ItemGroup>
      <AboutFiles Include="about\**\*" />
      <IconFiles Include="icons\**\*.png" />
      <LanguageFiles Include="lang\**\*" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDeployDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(AboutFiles)" DestinationFolder="$(ModDeployDir)\about\%(RecursiveDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(IconFiles)" DestinationFolder="$(ModDeployDir)\icons\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LanguageFiles)" DestinationFolder="$(ModDeployDir)\lang\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed to $(ModDeployDir)" />
  </Target>

</Project>

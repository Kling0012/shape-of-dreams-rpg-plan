  <!-- The test-visible PendingGimmick needs the product's value metadata at the same accessibility.
       Only visibility changes in this generated test compilation unit; src remains untouched. -->
  <Target Name="ExposeAuthoredPendingMetadata" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <AuthoredMechanismsSource>$([MSBuild]::Escape($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/HostAuthority.AuthoredMechanisms.cs').Replace('private struct AuthoredPendingGimmick', 'internal struct AuthoredPendingGimmick'))))</AuthoredMechanismsSource>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)HostAuthority.AuthoredMechanisms.cs"
                      Lines="$(AuthoredMechanismsSource)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="ExtractIssue62NativeCallbacks" BeforeTargets="CoreCompile">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/extract_issue62_native.py&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)Issue62.Native.cs&quot;" />
  </Target>

</Project>

<Project>
  <!-- ClientSession.cs mixes persistence and the entire Unity UI/runtime API. Compile its
       exact persistence methods and the Secure/Delve choice entry points, selected by syntax
       rather than copying their implementation. Whole standalone Mod partials remain normal
       linked Compile inputs in the project. -->
  <UsingTask TaskName="ExtractNativePersistence" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourcePath ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
      <RoslynPath ParameterType="System.String" Required="true" />
      <ClassName ParameterType="System.String" Required="true" />
      <Methods ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Late-bind the SDK's Roslyn: SDK 10 uses net10 assemblies while inline tasks
        // compile against a smaller reference set. Syntax still comes from the real AST.
        System.Reflection.Assembly.LoadFrom(System.IO.Path.Combine(RoslynPath, "Microsoft.CodeAnalysis.dll"));
        var roslyn = System.Reflection.Assembly.LoadFrom(System.IO.Path.Combine(RoslynPath, "Microsoft.CodeAnalysis.CSharp.dll"));
        var treeType = roslyn.GetType("Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree", true);
        var parse = treeType.GetMethods().Single(m => m.Name == "ParseText" && m.GetParameters().Length == 5
            && m.GetParameters()[0].ParameterType == typeof(string));
        var tree = parse.Invoke(null, new object[] { System.IO.File.ReadAllText(SourcePath), null, SourcePath, null, default(System.Threading.CancellationToken) });
        var root = tree.GetType().GetMethod("GetRoot", new[] { typeof(System.Threading.CancellationToken) })
            .Invoke(tree, new object[] { default(System.Threading.CancellationToken) });
        var descend = root.GetType().GetMethods().Single(m => m.Name == "DescendantNodes" && m.GetParameters().Length == 2);
        var nodes = ((System.Collections.IEnumerable)descend.Invoke(root, new object[] { null, false })).Cast<object>();
        System.Func<object, string> identifier = node => {
          var token = node.GetType().GetProperty("Identifier").GetValue(node);
          return (string)token.GetType().GetProperty("ValueText").GetValue(token);
        };
        System.Func<object, string> sourceText = node => (string)node.GetType().GetMethod("ToFullString", System.Type.EmptyTypes).Invoke(node, null);
        var wanted = Methods.Split(';');
        var session = nodes.Single(n => n.GetType().Name == "ClassDeclarationSyntax" && identifier(n) == ClassName);
        var members = ((System.Collections.IEnumerable)session.GetType().GetProperty("Members").GetValue(session)).Cast<object>();
        var methods = members.Where(m => m.GetType().Name == "MethodDeclarationSyntax" && wanted.Contains(identifier(m))).ToArray();
        if (methods.Length == 0 || wanted.Any(w => !methods.Any(m => identifier(m) == w))) throw new System.InvalidOperationException("Native persistence method contract changed; review the harness extraction.");
        var imports = ((System.Collections.IEnumerable)root.GetType().GetProperty("Usings").GetValue(root)).Cast<object>();
        var source = string.Concat(imports.Select(sourceText)) + "\nnamespace SodRpg.Mod { internal sealed partial class " + ClassName + " {\n"
            + string.Join("\n", methods.Select(sourceText)) + "\n} }\n";
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(OutputPath));
        System.IO.File.WriteAllText(OutputPath, source);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="CompileNativePersistence" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/ClientSession.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)NativePersistence.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="ClientSession" Methods="MarkDirty;TickPeriodicSave;SaveNow;FlushSaves;Secure;Delve" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)NativePersistence.g.cs" />
    </ItemGroup>
  </Target>

  <!-- The profile slot notice (#97) lives in the UI partial of ProfileSlotView.cs; compile its
       exact draw methods against the harness session instead of copying their implementation. -->
  <Target Name="CompileProfileSlotUi" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/ProfileSlotView.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)ProfileSlotUi.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="DreamforgeUi" Methods="DrawProfileSlots;DrawProfileMode" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ProfileSlotUi.g.cs" />
    </ItemGroup>
  </Target>
</Project>

<Project>
  <!-- Compile exact session methods selected by syntax, not copies of their implementation.
       The native boundary supplies transport, clocks and entity storage; checkpoint preparation,
       overflow, receipt queries and reward settlement execute the production code. -->
  <UsingTask TaskName="ExtractNativePersistence" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourcePath ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
      <RoslynPath ParameterType="System.String" Required="true" />
      <ClassName ParameterType="System.String" Required="true" />
      <Methods ParameterType="System.String" Required="true" />
      <Fields ParameterType="System.String" Required="false" />
      <NestedTypes ParameterType="System.String" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Late-bind the SDK's Roslyn: SDK 10 uses net10 assemblies while inline tasks
        // compile against a smaller reference set. Syntax still comes from the real AST.
        System.Reflection.Assembly.LoadFrom(System.IO.Path.Combine(RoslynPath, "Microsoft.CodeAnalysis.dll"));
        var roslyn = System.Reflection.Assembly.LoadFrom(System.IO.Path.Combine(RoslynPath, "Microsoft.CodeAnalysis.CSharp.dll"));
        var treeType = roslyn.GetType("Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree", true);
        var parse = treeType.GetMethods().Single(m => m.Name == "ParseText" && m.GetParameters().Length == 5
            && m.GetParameters()[0].ParameterType == typeof(string));
        var tree = parse.Invoke(null, new object[] { System.IO.File.ReadAllText(SourcePath), null, SourcePath, null, default(System.Threading.CancellationToken) });
        var root = tree.GetType().GetMethod("GetRoot", new[] { typeof(System.Threading.CancellationToken) })
            .Invoke(tree, new object[] { default(System.Threading.CancellationToken) });
        var descend = root.GetType().GetMethods().Single(m => m.Name == "DescendantNodes" && m.GetParameters().Length == 2);
        var nodes = ((System.Collections.IEnumerable)descend.Invoke(root, new object[] { null, false })).Cast<object>();
        System.Func<object, string> identifier = node => {
          var token = node.GetType().GetProperty("Identifier").GetValue(node);
          return (string)token.GetType().GetProperty("ValueText").GetValue(token);
        };
        System.Func<object, string> sourceText = node => (string)node.GetType().GetMethod("ToFullString", System.Type.EmptyTypes).Invoke(node, null);
        var wanted = Methods.Split(';');
        var session = nodes.Single(n => n.GetType().Name == "ClassDeclarationSyntax" && identifier(n) == ClassName);
        var members = ((System.Collections.IEnumerable)session.GetType().GetProperty("Members").GetValue(session)).Cast<object>().ToArray();
        var methods = members.Where(m => (m.GetType().Name == "MethodDeclarationSyntax"
            || m.GetType().Name == "PropertyDeclarationSyntax") && wanted.Contains(identifier(m))).ToArray();
        if (methods.Length == 0 || wanted.Any(w => !methods.Any(m => identifier(m) == w))) throw new System.InvalidOperationException("Native persistence member contract changed; review the harness extraction.");
        // Keep field types, grouped declarations and initializers exactly as authored in production.
        var wantedFields = (Fields ?? "").Split(new[] { ';' }, System.StringSplitOptions.RemoveEmptyEntries);
        System.Func<object, string[]> fieldNames = member => {
          var declaration = member.GetType().GetProperty("Declaration").GetValue(member);
          var variables = ((System.Collections.IEnumerable)declaration.GetType().GetProperty("Variables").GetValue(declaration)).Cast<object>();
          return variables.Select(identifier).ToArray();
        };
        var fields = members.Where(m => m.GetType().Name == "FieldDeclarationSyntax"
            && fieldNames(m).Any(wantedFields.Contains)).ToArray();
        if (wantedFields.Any(w => !fields.Any(f => fieldNames(f).Contains(w))))
          throw new System.InvalidOperationException("Native persistence field contract changed; review the harness extraction.");
        var wantedTypes = (NestedTypes ?? "").Split(new[] { ';' }, System.StringSplitOptions.RemoveEmptyEntries);
        var nestedTypes = members.Where(m => m.GetType().Name == "ClassDeclarationSyntax" && wantedTypes.Contains(identifier(m))).ToArray();
        if (wantedTypes.Any(w => !nestedTypes.Any(t => identifier(t) == w)))
          throw new System.InvalidOperationException("Native persistence nested type contract changed; review the harness extraction.");
        // Expose only the first type declaration; nested private classes and member defaults stay unchanged.
        var typeAccess = new System.Text.RegularExpressions.Regex(@"\bprivate(?=\s+(?:sealed\s+)?class\s+)");
        System.Func<object, string> exposeType = type => typeAccess.Replace(sourceText(type), "internal", 1);
        var imports = ((System.Collections.IEnumerable)root.GetType().GetProperty("Usings").GetValue(root)).Cast<object>();
        var modifiers = session.GetType().GetProperty("Modifiers").GetValue(session).ToString();
        if (!modifiers.Split(' ').Contains("partial")) modifiers += " partial";
        var source = string.Concat(imports.Select(sourceText)) + "\nnamespace SodRpg.Mod { " + modifiers + " class " + ClassName + " {\n"
            + string.Join("\n", fields.Select(sourceText).Concat(nestedTypes.Select(exposeType)).Concat(methods.Select(sourceText))) + "\n} }\n";
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(OutputPath));
        System.IO.File.WriteAllText(OutputPath, source);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="CompileNativePersistence" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/ClientSession.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)NativePersistence.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="ClientSession" Methods="ViewRevision;MarkDirty;MarkAllocationDirty;SavePendingAllocation;OnAllocationSceneChanged;DeferSave;TickSatchelOverflow;TickPeriodicSave;SaveNow;IsNewWriteFailure;RememberWriteFailureState;SetSaveErrorText;SetSaveErrorCause;ClearSaveError;FlushSaves;Secure;Delve;OnConcluded;IsVictory;TrackRun;CarryPendingResultIntoRecovery;ReadLimboDepth;HeroKeyOf;Emit;SendTrade;TradeUnavailable;SendLedgerProbe;SendPreparedTrade;SendDurableTrade;SendDueTradeQueries;RestoreSalvageTrade;OnTradeResult;TradeFailText;SalvageUnsecured;SalvageUnsecuredBulk;CanBulkSalvageUnsecured;SalvageScale;SalvageDust;CurrentZoneIndex" Fields="_ledgerProbeMisses;LedgerProbeFastTries;LedgerProbeFastInterval;LedgerProbeSlowInterval" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)NativePersistence.g.cs" />
    </ItemGroup>
  </Target>


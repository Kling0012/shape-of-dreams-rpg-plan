<Project>
  <!-- Compile exact session methods selected by syntax, not copies of their implementation.
       The native boundary supplies transport, clocks and entity storage; checkpoint preparation,
       overflow, receipt queries and reward settlement execute the production code. -->
  <UsingTask TaskName="ExtractNativePersistence" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SourcePath ParameterType="System.String" Required="true" />
      <OutputPath ParameterType="System.String" Required="true" />
      <RoslynPath ParameterType="System.String" Required="true" />
      <ClassName ParameterType="System.String" Required="true" />
      <Methods ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // Late-bind the SDK's Roslyn: SDK 10 uses net10 assemblies while inline tasks
        // compile against a smaller reference set. Syntax still comes from the real AST.
        System.Reflection.Assembly.LoadFrom(System.IO.Path.Combine(RoslynPath, "Microsoft.CodeAnalysis.dll"));
        var roslyn = System.Reflection.Assembly.LoadFrom(System.IO.Path.Combine(RoslynPath, "Microsoft.CodeAnalysis.CSharp.dll"));
        var treeType = roslyn.GetType("Microsoft.CodeAnalysis.CSharp.CSharpSyntaxTree", true);
        var parse = treeType.GetMethods().Single(m => m.Name == "ParseText" && m.GetParameters().Length == 5
            && m.GetParameters()[0].ParameterType == typeof(string));
        var tree = parse.Invoke(null, new object[] { System.IO.File.ReadAllText(SourcePath), null, SourcePath, null, default(System.Threading.CancellationToken) });
        var root = tree.GetType().GetMethod("GetRoot", new[] { typeof(System.Threading.CancellationToken) })
            .Invoke(tree, new object[] { default(System.Threading.CancellationToken) });
        var descend = root.GetType().GetMethods().Single(m => m.Name == "DescendantNodes" && m.GetParameters().Length == 2);
        var nodes = ((System.Collections.IEnumerable)descend.Invoke(root, new object[] { null, false })).Cast<object>();
        System.Func<object, string> identifier = node => {
          var token = node.GetType().GetProperty("Identifier").GetValue(node);
          return (string)token.GetType().GetProperty("ValueText").GetValue(token);
        };
        System.Func<object, string> sourceText = node => (string)node.GetType().GetMethod("ToFullString", System.Type.EmptyTypes).Invoke(node, null);
        var wanted = Methods.Split(';');
        var session = nodes.Single(n => n.GetType().Name == "ClassDeclarationSyntax" && identifier(n) == ClassName);
        var members = ((System.Collections.IEnumerable)session.GetType().GetProperty("Members").GetValue(session)).Cast<object>();
        var methods = members.Where(m => (m.GetType().Name == "MethodDeclarationSyntax"
            || m.GetType().Name == "PropertyDeclarationSyntax") && wanted.Contains(identifier(m))).ToArray();
        if (methods.Length == 0 || wanted.Any(w => !methods.Any(m => identifier(m) == w))) throw new System.InvalidOperationException("Native persistence member contract changed; review the harness extraction.");
        var imports = ((System.Collections.IEnumerable)root.GetType().GetProperty("Usings").GetValue(root)).Cast<object>();
        var source = string.Concat(imports.Select(sourceText)) + "\nnamespace SodRpg.Mod { internal sealed partial class " + ClassName + " {\n"
            + string.Join("\n", methods.Select(sourceText)) + "\n} }\n";
        System.IO.Directory.CreateDirectory(System.IO.Path.GetDirectoryName(OutputPath));
        System.IO.File.WriteAllText(OutputPath, source);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="CompileNativePersistence" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/ClientSession.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)NativePersistence.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="ClientSession" Methods="MarkDirty;DeferSave;TickSatchelOverflow;TickPeriodicSave;SaveNow;FlushSaves;Secure;Delve;TrackRun;ReadLimboDepth;HeroKeyOf;Emit;SendTrade;TradeUnavailable;SendLedgerProbe;SendPreparedTrade;SendDueTradeQueries;RestoreSalvageTrade;OnTradeResult;TradeFailText" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)NativePersistence.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CompileInfinityContinue" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/ClientSession.Infinity.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)InfinityContinue.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="ClientSession" Methods="InfinityStateDurable;HostInfinityStateDurable;InfinitySaveHoldReleased;InfinitySaveHoldSatisfied;HostInfinitySaveHoldSatisfied;PersistHostInfinityState;SaveInfinityState;SaveInfinityReceipt;BeginInfinitySaveHold;ResetInfinitySaveHold;CompleteInfinityStateSave;CountHostInfinityRoom;SyncInfinityContinueSnapshot;ObserveInfinityRoomTotal;TickInfinity;TryOpenInfinityChoice;AdvanceInfinityIdentity;ResetInfinityContinueState" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)InfinityContinue.g.cs" />
    </ItemGroup>
  </Target>

  <!-- The profile slot notice (#97) lives in the UI partial of ProfileSlotView.cs; compile its
       exact draw methods against the harness session instead of copying their implementation. -->
  <Target Name="CompileProfileSlotUi" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/ProfileSlotView.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)ProfileSlotUi.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="DreamforgeUi" Methods="DrawProfileSlots;DrawProfileMode" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)ProfileSlotUi.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CompileSatchelOverflowUi" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/DreamforgeUi.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)SatchelOverflowUi.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="DreamforgeUi" Methods="Notify;InvalidateHud;Decorate;SortedSatchel" />
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/UiStyles.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)OverflowUiStyles.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="UiStyles" Methods="RarityHex;Colored;RelicHex;RelicTitle" />
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/CodexView.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)OverflowCodexInvalidation.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="CodexView" Methods="Invalidate" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)SatchelOverflowUi.g.cs" />
      <Compile Include="$(IntermediateOutputPath)OverflowUiStyles.g.cs" />
      <Compile Include="$(IntermediateOutputPath)OverflowCodexInvalidation.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CompileRelicRowCacheUi" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/DreamforgeUi.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)RelicRowCacheUi.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="DreamforgeUi" Methods="CacheStamp;SortedCached;RowTexts" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)RelicRowCacheUi.g.cs" />
    </ItemGroup>
  </Target>

  <Target Name="CompileSecurePanelUi" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/DreamforgeUi.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)SecurePanelUi.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="DreamforgeUi" Methods="UpdateSecurePanel;ToggleSecurePanel" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)SecurePanelUi.g.cs" />
    </ItemGroup>
  </Target>
</Project>

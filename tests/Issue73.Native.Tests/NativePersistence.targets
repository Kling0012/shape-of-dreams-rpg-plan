    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)StarRefreshUi.g.cs" />
      <Compile Include="$(IntermediateOutputPath)StarClusterListUi.g.cs" />
    </ItemGroup>
  </Target>


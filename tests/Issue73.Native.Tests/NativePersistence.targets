  <!-- 自動分解（#1010）。ClientSession.AutoSalvage.cs は未リンクのため、Emit・OnTradeResult・Tick の
       抽出が参照する候補の登録・送信・成功案内の抑制とその状態を実ソースから抽出する。
       ConfigureAutoSalvage は DreamforgeConfig（未リンク）の型を取るため抽出しない
       （境界では _autoSalvageBelow が null のまま=既定の「しない」）。 -->
  <Target Name="CompileAutoSalvage" BeforeTargets="CoreCompile">
    <ExtractNativePersistence SourcePath="$(MSBuildProjectDirectory)/../../src/SodRpg.Mod/ClientSession.AutoSalvage.cs" OutputPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)AutoSalvage.g.cs" RoslynPath="$(MSBuildToolsPath)/Roslyn/bincore" ClassName="ClientSession" Methods="QueueAutoSalvage;TickAutoSalvage;EmitLogOnly" Fields="_autoSalvageBelow;_autoSalvageQueue;_autoSalvagePrepared;_autoSalvageTokens" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)AutoSalvage.g.cs" />
    </ItemGroup>
  </Target>


<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/SodRpg.Core/SodRpg.Core.csproj" />
    <Compile Include="Program.cs" />
    <Compile Include="NativeApi.cs" />
    <Compile Include="$(IntermediateOutputPath)ProductionMethods.cs" />
    <Compile Include="../../../src/SodRpg.Mod/TravelerCombatNative.cs" />
    <Compile Include="../../../src/SodRpg.Mod/CoopDistanceNative.cs" />
    <Compile Include="../../../src/SodRpg.Mod/HostAuthority.MeleeCoop.cs" />
    <Compile Include="../../../src/SodRpg.Mod/DreamforgeConfig.cs" />
  </ItemGroup>
  <Target Name="ExtractProductionMethods" BeforeTargets="CoreCompile">
    <Exec Command="python3 &quot;$(MSBuildProjectDirectory)/extract.py&quot; &quot;$(MSBuildProjectDirectory)/$(IntermediateOutputPath)ProductionMethods.cs&quot;" />
  </Target>
</Project>

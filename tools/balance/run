#!/usr/bin/env python3
"""Generate, validate, measure and compare balance snapshots."""
from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from decimal import Decimal

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent.parent
sys.path.insert(0, str(HERE))
import gen_cs


def execute(command: list[str], env: dict[str, str]) -> None:
    print("+ " + " ".join(command), flush=True)
    subprocess.run(command, cwd=ROOT, env=env, check=True)


def json_text(value, *, sort_keys: bool = False) -> str:
    """Keep Decimal values as JSON numbers; stdlib json only supports binary floats."""
    if isinstance(value, Decimal):
        if not value.is_finite():
            raise ValueError("Non-finite JSON number")
        return str(value)
    if isinstance(value, dict):
        items = sorted(value.items()) if sort_keys else value.items()
        return "{" + ", ".join(json.dumps(key, ensure_ascii=False) + ": " +
                              json_text(item, sort_keys=sort_keys) for key, item in items) + "}"
    if isinstance(value, list):
        return "[" + ", ".join(json_text(item, sort_keys=sort_keys) for item in value) + "]"
    return json.dumps(value, ensure_ascii=False, allow_nan=False)


def number(value: int | float | Decimal | None) -> str:
    if value is None:
        return "—"
    if isinstance(value, Decimal):
        return str(value)
    return format(value, ".17g")


def shown(entry: dict | None) -> str:
    if entry is None:
        return "—"
    value = number(entry["value"])
    if entry["status"] == "cap":
        return value + "（上限・次の操作不可）"
    if entry["status"] == "inapplicable":
        return value + "（対象外）"
    if entry["status"] == "not-reached":
        return "未到達"
    if entry["status"] == "no-damage-nodes":
        return "対象星なし（効率未定義）"
    if entry["status"] in ("ok", "weak", "strong"):
        return value + "（" + {"ok": "基準内", "weak": "弱すぎ", "strong": "強すぎ"}[entry["status"]] + "）"
    if entry["status"] in ("set-reference-only", "boss-payload-excluded", "stage-selector-not-tuning"):
        return "参照のみ（" + entry["status"] + "）"
    return value


def comparison(current: dict, previous: dict | None) -> str:
    validated = current["validation"]["testsPassed"]
    lines = ["# バランス比較", "",
             "検証: " + ("全通常テスト成功（--slow 指定時のみ低速も実行）" if validated else
                         "レポート専用・テスト未実行（検証済み基準には使いません）"), "",
             "現在: " + current["createdAt"],
             "前回成功: " + (previous["createdAt"] if previous else "なし（初回）"), "",
             "Git revision 現在: `" + (current.get("gitRevision") or "unknown") + "`",
             "Git revision 前回: " + ("`" + (previous.get("gitRevision") or "unknown") + "`" if previous else "—"), "",
             "数値はJSONの未丸め値。相対差は (現在−前回)/前回 ×100%。前回0・未到達・比較不可は —。",
             "率 (%) の絶対差は percentage points (pp)、効率の差は %/点。ratio は倍率/確率の比率そのもの。欠片・調律石・個数等は行の単位で比較し、型・単位が異なる行は比較しません。",
             "forge はCoreの実支払い・累計倍率・基本報酬・独立した工房状態の投影で、戦闘性能予測ではありません。上限/対象外は未定義で0とは区別します。",
             "star-values は実登録された星の種類・効果・欄・単位別の定義値。異種量は合算せず、DPS・発動頻度・実戦Buildの模型ではありません。追加/削除と実測0を区別します。", ""]
    lines.extend(["v132stars はCoreの鍛錬帳簿に決定的な平均行動を流した模型。到達zone・最終stat・感度で比較し、未到達は0にしません。星XP曲線は star-progression のCore実式で別に列挙します。", ""])
    lines.extend(["pressure はCoreの圧／深度／敵定義の決定的な投影。infinity は全sessionを戦闘時間とする既存経済模型で、勝率・実クリア時間・通信性能ではありません。", ""])
    lines.extend(["equipment はCoreの土台・固有品・抽選範囲／重み・上限を種類と単位別に列挙します。通貨上限は戦闘能力の上限と区別します。sets は既存のcap正規化予算であり、戦闘DPS・勝率の予測ではありません。", ""])
    if "tableMetadata" in current:
        lines.extend(["調整表メタデータ 現在: `" + json_text(current["tableMetadata"], sort_keys=True) + "`",
                      "調整表メタデータ 前回: " + ("`" + json_text(previous["tableMetadata"], sort_keys=True) + "`"
                                           if previous and "tableMetadata" in previous else "—"), ""])
    for snapshot in current["snapshots"]:
        prior = next((s for s in previous["snapshots"] if s["mode"] == snapshot["mode"]), None) if previous else None
        compatible = (prior is not None and prior["modelVersion"] == snapshot["modelVersion"]
                      and prior["conditions"] == snapshot["conditions"])
        lines.extend(["## " + snapshot["mode"], "",
                      "ContentFingerprint 現在: `" + snapshot["contentFingerprint"] + "`",
                      "ContentFingerprint 前回: " + ("`" + prior["contentFingerprint"] + "`" if prior else "—"),
                      "前回条件: " + ("`" + json_text(prior["conditions"], sort_keys=True) + "`" if prior else "—"),
                      "条件: `" + json_text(snapshot["conditions"], sort_keys=True) + "`", ""])
        if not compatible:
            lines.extend(["比較不可: " + ("前回なし" if prior is None else "モデル版または正規化条件が異なります") + "。現在値のみ。", ""])
        prior_metrics = {e["id"]: e for e in prior["metrics"]} if prior else {}
        current_metrics = {e["id"]: e for e in snapshot["metrics"]}
        lines.extend(["| 指標 | 単位 | 現在 | 前回成功 | 差 | 相対差 |", "| --- | --- | ---: | ---: | ---: | ---: |"])
        for metric_id in dict.fromkeys((*current_metrics, *prior_metrics)):
            entry = current_metrics.get(metric_id)
            old = prior_metrics.get(metric_id)
            delta = relative = "—"
            same_quantity = (old is not None and entry is not None and old.get("unit") == entry.get("unit")
                             and type(old["value"]) in (int, float, Decimal) and type(entry["value"]) in (int, float, Decimal))
            same_quantity = same_quantity and old.get("type") == entry.get("type")
            if compatible and same_quantity and old["status"] == entry["status"]:
                old_value = Decimal(str(old["value"]))
                difference = Decimal(str(entry["value"])) - old_value
                delta = number(difference)
                if entry["id"].endswith("/failurePercent") or entry.get("unit") == "percent":
                    delta += " pp"
                elif entry.get("unit") == "percent/point":
                    delta += " %/点"
                elif entry.get("unit") == "points":
                    delta += " 点"
                elif entry.get("unit") == "nodes":
                    delta += " 星"
                elif entry.get("unit") is not None:
                    delta += " " + entry["unit"]
                if old_value != 0:
                    relative = number(difference / old_value * 100) + "%"
            elif (compatible and old is not None and entry is not None and old.get("unit") == entry.get("unit")
                  and {old["status"], entry["status"]} == {"not-reached", "measured"}):
                delta = shown(old) + " → " + shown(entry)
            elif compatible and same_quantity and {old["status"], entry["status"]} <= {"ok", "weak", "strong"}:
                old_value = Decimal(str(old["value"]))
                difference = Decimal(str(entry["value"])) - old_value
                delta = number(difference) + " " + entry["unit"]
                if old_value != 0:
                    relative = number(difference / old_value * 100) + "%"
            label = (entry or old)["label"].replace("|", "\\|").replace("\n", " ")
            if snapshot["mode"] == "equipment":
                label += " (`" + metric_id.replace("|", "\\|") + "`)"
            current_value = shown(entry) if entry is not None else "削除"
            previous_value = ("比較不可" if not compatible and prior is not None else
                              shown(old) if old is not None else "追加/なし")
            unit = (entry or old).get("unit", "—").replace("|", "\\|").replace("\n", " ")
            lines.append(f"| {label} | {unit} | {current_value} | {previous_value} | {delta} | {relative} |")
        lines.append("")
    return "\n".join(lines) + "\n"


def atomic_json(path: Path, data: dict) -> None:
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=path.parent,
                                         prefix=".baseline-", suffix=".tmp", delete=False) as stream:
            temporary = Path(stream.name)
            stream.write(json_text(data))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def git_revision() -> str | None:
    try:
        result = subprocess.run(["git", "rev-parse", "--verify", "HEAD"], cwd=ROOT,
                                capture_output=True, text=True, check=True)
        return result.stdout.strip() or None
    except (OSError, subprocess.CalledProcessError):
        return None


def main() -> int:
    parser = argparse.ArgumentParser(description="鍛冶＋星値＋星XP＋鍛錬＋圧／敵＋Infinity＋遠征の生成・検証・前回成功比較")
    parser.add_argument("--no-tests", action="store_true", help="テストなし。検証済み基準とは別のレポート専用基準を使用")
    parser.add_argument("--slow", action="store_true", help="既存の低速テストも実行（既定は通常全テスト）")
    parser.add_argument("--out-dir", type=Path, default=HERE / "results", help="結果・基準の保存先")
    parser.add_argument("--runs", type=int, default=3)
    parser.add_argument("--players", type=int, default=8)
    parser.add_argument("--seed", type=int, default=1)
    args = parser.parse_args()
    if args.no_tests and args.slow:
        parser.error("--slow と --no-tests は同時に使えません")
    if args.runs < 1 or args.players < 1 or not 0 <= args.seed <= 2**64 - 1:
        parser.error("runs/players は1以上、seed は非負の64ビット整数です")
    try:
        # Validation precedes generation; generation never substitutes runtime JSON loading.
        forge_data = gen_cs.load_forge()
        if not gen_cs.generate():
            raise RuntimeError("C#生成に失敗しました")
        if not gen_cs.generate(check=True):
            raise RuntimeError("生成C#が最新ではありません")
        stars_data = json.loads((HERE / "stars.json").read_text(encoding="utf-8"), parse_float=Decimal)
        table_metadata = {"forge": forge_data,
                          "gear": gen_cs.gear_values.load_gear(),
                          "sets": gen_cs.set_values.load_sets(),
                          "stars": {"schemaVersion": stars_data["schemaVersion"],
                                    "multipliers": stars_data["multipliers"],
                                    "rankScaling": stars_data["rankScaling"]},
                          "runGrowth": gen_cs.star_values.load_growth_table(),
                          "starProgression": gen_cs.star_progression_values.load(),
                          "pressure": gen_cs.pressure_values.load(),
                          "monsters": gen_cs.monster_values.load(),
                          "infinity": gen_cs.infinity_values.load()}
        table_metadata["equipment"] = {
            path.stem: json.loads(path.read_text(encoding="utf-8"), parse_float=Decimal)
            for path in sorted((HERE / "equipment").glob("*.json"))
        }
        requested_dotnet = os.environ.get("DOTNET")
        dotnet = shutil.which(requested_dotnet or "dotnet")
        if dotnet is None:
            raise RuntimeError("dotnet が見つかりません。SDKを導入するか DOTNET を指定してください")
        env = dict(os.environ)
        env["DOTNET"] = dotnet
        # DOTNET_ROLL_FORWARD, including LatestMajor, is inherited unchanged.
        execute([dotnet, "build", "tools/BalanceSim/BalanceSim.csproj", "-c", "Release", "--nologo"], env)
        if not args.no_tests:
            command = [sys.executable, "tools/test_changed.py", "--all"]
            if args.slow:
                command.append("--slow")
            execute(command, env)
            execute([sys.executable, "-m", "unittest", "discover", "-s", "tools/tests", "-p", "test_*.py"], env)
        out_dir = args.out_dir.resolve()
        out_dir.mkdir(parents=True, exist_ok=True)
        baseline_path = out_dir / ("last-report-only.json" if args.no_tests else "last-success.json")
        previous = json.loads(baseline_path.read_text(encoding="utf-8"), parse_float=Decimal) if baseline_path.exists() else None
        with tempfile.TemporaryDirectory(dir=out_dir, prefix=".pending-") as pending:
            staging = Path(pending)
            dll = ROOT / "tools/BalanceSim/bin/Release/net8.0/BalanceSim.dll"
            snapshots = []
            for mode in ("forge", "star-efficiency", "star-values", "star-progression", "v132stars", "pressure", "infinity", "expeditions"):
                # Each invocation starts a separate process, isolating static Core state.
                command = [dotnet, str(dll), "--mode", mode, "--out", str(staging / f"{mode}.md"),
                           "--metrics-json", str(staging / f"{mode}.json")]
                if mode == "expeditions":
                    command.extend(["--runs", str(args.runs), "--players", str(args.players), "--seed", str(args.seed),
                                    "--zones", "2", "--rooms", "2"])
                elif mode == "v132stars":
                    command.extend(["--runs", str(args.runs), "--players", str(args.players), "--seed", str(args.seed),
                                    "--zones", "4", "--rooms", "5"])
                elif mode == "infinity":
                    command.extend(["--infinity-scope", "comparison", "--players", str(args.players), "--seed", str(args.seed)])
                execute(command, env)
                snapshots.append(json.loads((staging / f"{mode}.json").read_text(encoding="utf-8"), parse_float=Decimal))
            for mode in ("equipment", "sets"):
                execute([dotnet, str(dll), "--mode", mode, "--out", str(staging / f"{mode}.md"),
                         "--metrics-json", str(staging / f"{mode}.json")], env)
                snapshots.append(json.loads((staging / f"{mode}.json").read_text(encoding="utf-8"), parse_float=Decimal))
            current = {"modelVersion": 1, "createdAt": datetime.now(timezone.utc).isoformat(),
                       "validation": {"testsPassed": not args.no_tests, "slow": args.slow},
                       "gitRevision": git_revision(), "tableMetadata": table_metadata, "snapshots": snapshots}
            (staging / "current.json").write_text(json_text(current) + "\n", encoding="utf-8")
            (staging / "comparison.md").write_text(comparison(current, previous), encoding="utf-8")
            name = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ") + ("-report-only" if args.no_tests else "-validated")
            destination = out_dir / name
            os.replace(staging, destination)
            # The sole baseline commit occurs after generation/build/tests/all measurements/report succeed.
            atomic_json(baseline_path, current)
        print("比較: " + str(destination / "comparison.md"))
        print("基準: " + str(baseline_path))
        return 0
    except (OSError, ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        print("失敗（前回成功基準は保持）: " + str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
